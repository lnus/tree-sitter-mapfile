  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "MapServer Mapfile grammar for tree-sitter",
    "authors": [{ "name": "Linus Wæhler", "email": "17277861+lnus@users.noreply.github.com" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
